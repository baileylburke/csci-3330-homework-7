<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="css/styles.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="js/source.js"></script>

</head>

<body>
    <header class="header">
        <h1>Admin Dashboard</h1>
        <div class="user-info">Welcome, <span id="username">UTRGV Vaqueros</span></div>
    </header>

    <div class="dashboard">

        <aside class="sidebar">
            <button class="nav-button" data-section="dashboard">
                Dashboard
            </button>
            <button class="nav-button" data-section="customers">
                Customers
            </button>
            <button class="nav-button" data-section="reports">
                Reports
            </button>
            <button id="newCustomerButton">
                + New Customer
            </button>
        </aside>

        <main class="content">

            <section class="stats">
                <div class="card" id="card-revenue">
                    <div class="stat-title">Revenue</div>
                    <div class="stat-value green"><span class="revenue-amt"><%= money(revenue) %></span></div>
                </div>
                <div class="card" id="card-customers">
                    <div class="stat-title">Customers</div>
                    <div class="stat-value blue"><span id="customer-num"><%= number(customerCount) %></span></div>
                </div>
                <div class="card" id="card-orders">
                    <div class="stat-title">Orders</div>
                    <div class="stat-value orange"><span id="orders-amt"><%= number(orders) %></span></div>
                </div>
                <div class="card" id="card-issues">
                    <div class="stat-title">Issues</div>
                    <div class="stat-value red"><span id="issues-amt"><%= number(issueCount) %></span></div>
                </div>
            </section>


            <div class="dashboard-grid">
                <div>
                    <section class="panel">
                        <div id="dashboardTabs">
                            <ul>
                                <li><a href="#tab-overview">Overview</a></li>
                                <li><a href="#tab-sales">Sales</a></li>
                            </ul>

                            <div id="tab-overview">
                                <h3>Monthly Performance</h3>
                                <p>Revenue is currently at <strong class="revenue-amt"><%= money(revenue) %></strong></p>
                            </div>

                            <div id="tab-sales">
                                <h3>Sales Summary</h3>
                                <table id="salesTable">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Sales</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>

                                    <tbody id="salesTableBody">
                                        <% for (const sale of sales) { %>
                                            <tr>
                                                <td><%= sale.name || 'Unknown product' %></td>
                                                <td><%= number(sale.quantity) %></td>
                                                <td><%= money(sale.saleamount) %></td>
                                            </tr>
                                        <% } %>
                                        <% if (sales.length === 0) { %>
                                            <tr><td colspan="3">No sales found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </section>


                    <section class="panel">
                        <h2>Customers</h2>
                        <table id="customerTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>

                            <tbody id="customerTableBody">
                                <% for (const customer of customers) { %>
                                    <tr>
                                        <td><%= customer.name %></td>
                                        <td><%= customer.email %></td>
                                        <td><span class="status <%= customer.status === 'active' ? 'status-active' : 'status-pending' %>"><%= customer.status %></span></td>
                                        <td><%= date(customer.datejoined) %></td>
                                    </tr>
                                <% } %>
                                <% if (customers.length === 0) { %>
                                    <tr><td colspan="4">No customers found.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </section>
                </div>


                <div>
                    <section class="panel">
                        <div id="accordion">
                            <h3>Issues</h3>
                            <div>
                                <div class="green">
                                    <ul id="system-status-list">
                                        <% for (const alert of issues) { %>
                                            <li><%= alert.description %></li>
                                        <% } %>
                                        <% if (issues.length === 0) { %>
                                            <li>No issues found.</li>
                                        <% } %>
                                    </ul>
                                </div>
                            </div>

                            <h3>Notifications</h3>
                            <div>
                                <p>You have <span id="notification-num"><%= number(notificationCount) %></span> new notifications.</p>
                                <ol id="notifications-list">
                                        <% for (const alert of notifications) { %>
                                            <li><%= alert.description %></li>
                                        <% } %>
                                        <% if (notifications.length === 0) { %>
                                            <li>No notifications found.</li>
                                        <% } %>
                                    </ol>
                            </div>

                            <h3>Tasks</h3>
                            <div>
                                <ul id="tasks-list">
                                        <% for (const alert of tasks) { %>
                                            <li><%= alert.description %></li>
                                        <% } %>
                                        <% if (tasks.length === 0) { %>
                                            <li>No tasks found.</li>
                                        <% } %>
                                    </ul>
                            </div>

                        </div>
                    </section>

                    <section class="panel">
                        <h2>Under construction...</h2>
                    </section>

                    <section class="panel">
                        <h2>Under construction...</h2>
                    </section>

                </div>

            </div>

        </main>

    </div>



    <div id="customerDialog" title="Customer Form Preview">
        <p>This form is a preview. Customer changes are not saved.</p>
        <div class="form-row">
            <label for="customerName">Name</label>
            <input type="text" id="customerName">
        </div>

        <div class="form-row">
            <label for="customerEmail">Email</label>
            <input type="email" id="customerEmail">
        </div>


        <div class="form-row">
            <label for="customerType">Customer Type</label>
            <select id="customerType">
                <option>Standard</option>
                <option>Premium</option>
                <option>Enterprise</option>
            </select>
        </div>

        <div class="form-row">
            <label for="customerDate">Registration Date</label>
            <input type="text" id="customerDate">
        </div>
    </div>




</body>
</html>
